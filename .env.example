# Copy to .env (git-ignored). On Railway set these as service variables.
PROJECT=oikn
POSTGRES_PASSWORD=change-me
CITYDB_SRID=32750            # fixed at the FIRST start of the db volume
CITYDB_HEIGHT_EPSG=4979
DATABASE_URL=postgres://postgres:change-me@db:5432/postgres?sslmode=disable   # owner: migrations, bootstrap
APP_DB_PASSWORD=change-me-app   # login role twin_app (Django admin)
API_DB_PASSWORD=change-me-api   # login role twin_api (read-only API)
SECRET_KEY=change-me-long-random
DEBUG=0
ALLOWED_HOSTS=*
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin
ADMIN_EDIT_ENABLED=0         # 0 = read-only admin (checkpoint), 1 = editing on
